<?xml version="1.0" encoding="UTF-8"?>
<!-- Olga Liliana Ruvalcaba Mata -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="veterinaria">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="mascotas">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="mascota" minOccurs="1" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="ID_CLIENTE" type="xs:string"/>
                    <xs:element name="Nombre_cliente" type="xs:string"/>
                    <xs:element name="Telefono" type="xs:string"/>
                    <xs:element name="Nombre_mascota" type="xs:string"/>
                    <xs:element name="Especie" type="xs:string"/>
                    <xs:element name="servicios">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="servicio" minOccurs="1" maxOccurs="unbounded">
                            <xs:complexType>
                              <xs:sequence>
                                <xs:element name="Servicio" type="xs:string"/>
                                <xs:element name="Fecha" type="xs:date"/>
                                <xs:element name="Costo" type="xs:int"/>
                              </xs:sequence>
                            </xs:complexType>
                          </xs:element>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>